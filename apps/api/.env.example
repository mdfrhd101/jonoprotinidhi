# Copy to .env (never commit .env). Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/jonoshetu_dev
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
MASTER_KEY=BASE64_32_BYTES
PHONE_PEPPER=change-me-random-string
PLATFORM_DOMAIN=jonoshetu.localhost
CORS_ORIGINS=http://localhost:5173
TURNSTILE_SECRET=
SMS_PROVIDER=console
# first super admin (used by `npm run seed`)
SEED_SUPER_EMAIL=admin@octagram.example
SEED_SUPER_PASSWORD=
MEDIA_HOSTS=upload.wikimedia.org,thumb.wikimedia.org,cdn.jonoshetu.example

# Dev only: false = password-only login (no 2-step code). The API refuses to start with false when NODE_ENV=production.
MFA_REQUIRED=true

# Uploaded images (dev disk storage) and public origin used in their URLs
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://127.0.0.1:4000
MAX_UPLOAD_MB=8

# Shared secret with the public site server (apps/web-public, same value there). Only requests with it may name the visitor IP
# in X-Client-IP, so rate limits stay per visitor. Empty = off. At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_SERVER_TOKEN=
